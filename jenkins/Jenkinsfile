pipeline
{

    agent {
    label 'DevServer'
    }
    tools{
        myMaven 'Maven'
    }
    stages{
         stage('Build')
        {
           
            steps{
                sh 'mvn clean package'
            }

        post {
             success {
                echo 'Build Success archiving.............'
                archiveArtifacts artifacts: '**/target/*.war'
                    }
            }

        }
   
}
}